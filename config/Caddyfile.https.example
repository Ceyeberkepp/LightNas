# OPTIONAL custom-domain reverse proxy; not required for LightNAS LAN HTTPS.
# Each appliance serves HTTPS directly at https://<its-own-LAN-IP>:3080.
# This template is ONLY for an administrator-configured domain.
# Replace lightnas.example.com with a hostname that belongs to THAT appliance.
# When forwarding to a TLS upstream, configure TLS verification/trust explicitly.
lightnas.example.com {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
    }
    reverse_proxy https://127.0.0.1:3080 {
        transport http {
            tls_server_name localhost
            tls_trusted_ca_certs /etc/lightnas/tls/nas.crt
        }
    }
}
